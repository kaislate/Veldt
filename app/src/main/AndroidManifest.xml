<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Read on-device audio for the local library (spec §6.2).
         Android 13+ uses the scoped READ_MEDIA_AUDIO; pre-13 falls back to
         READ_EXTERNAL_STORAGE. Runtime request lives in the UI (Task 7). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Self-hosted server access (design spec §12, N1). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ConnectivityManager.isActiveNetworkMetered, for the mobile-data bitrate cap (N2).
         WorkManager's manifest merges this in too; declared here so the cap does not depend
         on a transitive manifest. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The built-in pill's overlay window (P1.5c, spec §3). Requested from the settings
         screen via ACTION_MANAGE_OVERLAY_PERMISSION; Settings.canDrawOverlays reports it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Package visibility (API 30+) so PackageManager.getPackageInfo can see whether Veldt
         Wisp is installed, for the pill's Wisp-deference gate (spec §3). -->
    <queries>
        <package android:name="com.kaislate.veldt" />
    </queries>

    <!-- Measured on an LG G7 (API 29, Veldt's own uid): Environment.isExternalStorageLegacy()
         was false and EVERY file-path read of shared storage (the .mp3s, a sidecar .lrc) hit
         EACCES, while MediaStore content-uri reads succeeded. Adding this flag flipped
         isExternalStorageLegacy() to true and made all three files readable by path on the same
         device (an update install sufficed) — eAlvaTag's `File(_DATA)` tag reads, embedded-art-
         by-path, embedded lyrics and sidecar .lrc all depend on it. This flag has effect ONLY on
         API 29: with targetSdk >= 30 it is ignored on API 30+, where scoped storage applies
         regardless. -->
    <application
        android:name=".VeldtApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veldt">

        <!-- configChanges="uiMode": on API 31+ LaunchTheme hands the user's theme choice to the
             system as a per-app night mode, so the next cold start's launch window matches it
             (finding 10), and the system applies that change to the running app at once.
             Declared here, it arrives as a configuration change that Compose absorbs (VeldtTheme
             re-resolves from the new configuration) instead of relaunching the activity in the
             middle of Settings. A system dark-mode switch is handled the same way. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:theme="@style/Theme.Veldt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>

        <!-- Remove WorkManager's default initializer so our custom
             Configuration.Provider (VeldtApp) drives on-demand init. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
